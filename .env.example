# Public client configuration (never put a service-role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Required for Capacitor; deployed HTTPS backend serving /api/ai-*
VITE_API_BASE_URL=https://YOUR_APP.example
# Allowed Supabase password recovery redirect to the web version
VITE_AUTH_REDIRECT_URL=https://YOUR_APP.example/
# Optional: directory containing the original MP3 filenames, if not using admin audio URLs
# VITE_AUDIO_BASE_URL=https://YOUR_MEDIA.example/audio

# Server-only, set in hosting environment (never prefix ANTHROPIC key with VITE_)
ANTHROPIC_API_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
AI_ALLOWED_ORIGINS=https://YOUR_APP.example
# APP_BASE_PATH=/frisson-app/ for a static GitHub Pages build; default is /
